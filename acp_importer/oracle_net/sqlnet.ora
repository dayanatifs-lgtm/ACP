# Used by DB Sync thick mode (Native Network Encryption / checksum).
# Older IFS 12c listeners negotiate SHA1/MD5; listing SHA256 first causes ORA-12569.
DISABLE_OOB = ON
SQLNET.AUTHENTICATION_SERVICES = (NONE)
SQLNET.ALLOWED_LOGON_VERSION_CLIENT = 8
SQLNET.ENCRYPTION_CLIENT = accepted
SQLNET.ENCRYPTION_TYPES_CLIENT = (AES256, AES192, AES128, 3DES168, 3DES112)
SQLNET.CRYPTO_CHECKSUM_CLIENT = accepted
SQLNET.CRYPTO_CHECKSUM_TYPES_CLIENT = (MD5, SHA1)
