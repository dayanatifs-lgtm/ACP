# Copy to .env and supply values outside source control.
IFS_BASE_URL=https://your-environment.ifs.cloud/main/ifsapplications/projection/v1
IFS_TOKEN_URL=https://your-environment.ifs.cloud/auth/realms/your-realm/protocol/openid-connect/token
IFS_CLIENT_ID=
IFS_CLIENT_SECRET=

# client_credentials is preferred for an IAM integration client.  Use password only
# when your IAM administrator explicitly enables the resource-owner-password grant.
IFS_GRANT_TYPE=client_credentials
IFS_TOKEN_CLIENT_AUTH=basic
IFS_SCOPE=
IFS_USERNAME=
IFS_PASSWORD=

IFS_ACP_FOLDER=C:\\UpdaClones
IFS_POLL_SECONDS=2
IFS_TIMEOUT_SECONDS=300
IFS_REQUEST_TIMEOUT_SECONDS=60
IFS_VERIFY_TLS=true
# Optional: only set if your environment rejects bearer-only REST calls.
IFS_XSRF_TOKEN=
