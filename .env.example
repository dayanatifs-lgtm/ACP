# Gemini (Direct ACP Clone → Redeploy with AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Optional full generateContent URL. Default is Google AI Studio:
# https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent
GEMINI_API_URL=
# Corporate SSL inspection: leave VERIFY true (uses Windows CA store via truststore).
# Or set GEMINI_CA_BUNDLE to your company root CA .pem. Last resort: GEMINI_VERIFY_TLS=false
GEMINI_VERIFY_TLS=true
GEMINI_CA_BUNDLE=

# Dashboard login (email + password)
AUTH_ENABLED=true
AUTH_ALLOW_SIGNUP=true
AUTH_SECRET=change-this-to-a-long-random-string
APP_BASE_URL=http://dse1thorftp1:8088
# Optional SMTP for verification / forgot-password emails.
# If SMTP_HOST is empty, links are written to logs/auth-links.log instead
# and shown once in the UI (using the browser host when APP_BASE_URL is localhost).
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=<your SendGrid API key>
#   SMTP_FROM=noreply@your-verified-domain.com
#   SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true


# Per-user uploaded ACP packages (server path). Default: <project>/workspaces
ACP_WORKSPACES_ROOT=
